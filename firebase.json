{
  "firestore": {
    "database": "(default)",
    "location": "us-east1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": { "firestore": { "port": 8189 }, "ui": { "enabled": false } },
  "auth": {
    "providers": {
      "anonymous": true
    }
  },
  "hosting": {
    "site": "coast-wild-20260915",
    "public": ".firebase-public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/content/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      }
    ]
  }
}
